@model StudentManagement.Models.Student

@{
    Layout = null;
    ViewData["Title"] = "Thông tin sinh viên";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Thông tin sinh viên</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            margin: 0;
            padding: 40px;
        }

        .container {
            max-width: 600px;
            margin: 80px auto;
            background-color: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
        }

        h1 {
            text-align: center;
            color: #222;
            margin-bottom: 35px;
        }

        .info {
            font-size: 20px;
            line-height: 1.8;
        }

        .info p {
            margin: 18px 0;
        }

        .label {
            font-weight: bold;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>Thông tin sinh viên</h1>

        <div class="info">

            <p>
                <span class="label">Tên:</span>
                @ViewBag.Name
            </p>

            <p>
                <span class="label">Tuổi:</span>
                @ViewData["Age"]
            </p>

            <p>
                <span class="label">Ngành:</span>
                @Model.Major
            </p>

        </div>

    </div>

</body>
</html>