@model List<StudentManagement.Models.Book>

<h2>Danh sách sách</h2>

<a href="/Book/Create">Thêm sách</a>

<br />
<br />

<table border="1" cellpadding="10">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Price</th>
        <th>Action</th>
    </tr>

    @foreach (var book in Model)
    {
        <tr>
            <td>@book.Id</td>
            <td>@book.Name</td>
            <td>@book.Price</td>
            <td>
                <a href="/Book/Detail/@book.Id">Chi tiết</a>
            </td>
        </tr>
    }
</table>